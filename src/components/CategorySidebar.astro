---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getUniqueCategories } from "@/utils/getUniqueCategories";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  /** Slug of the category currently being viewed, used for highlighting. */
  current?: string;
};

const { current } = Astro.props;

const posts = await getCollection("posts");
const categories = getUniqueCategories(posts);
const totalPosts = categories.reduce((sum, item) => sum + item.count, 0);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<aside
  class="hidden lg:block"
  aria-labelledby="category-sidebar-title"
  data-pagefind-ignore
>
  <div
    class="sticky top-10 max-h-[calc(100vh-5rem)] overflow-x-hidden overflow-y-auto pe-1"
  >
    <h2
      id="category-sidebar-title"
      class="border-border border-b pb-2 text-sm font-semibold tracking-[0.15em]"
    >
      <a
        href={getRelativeLocaleUrl(locale, "categories/")}
        class="text-muted-foreground hover:text-accent transition-colors"
      >
        {t.post.categoryLabel}
      </a>
    </h2>

    <ul class="mt-3 space-y-0.5 text-[0.9375rem]">
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "posts/")}
          aria-current={!current ? "page" : undefined}
          class:list={[
            "hover:text-accent -mx-2 flex items-baseline justify-between gap-2 rounded-sm px-2 py-1.5 transition-colors",
            { "text-accent bg-accent/10 font-semibold": !current },
          ]}
        >
          <span class="truncate">{t.home.allPosts}</span>
          <span
            class="text-muted-foreground shrink-0 text-[0.8125rem] tabular-nums"
          >
            {totalPosts}
          </span>
        </a>
      </li>

      {
        categories.map(({ category, categoryName, count }) => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `categories/${category}/`)}
              aria-current={current === category ? "page" : undefined}
              class:list={[
                "hover:text-accent -mx-2 flex items-baseline justify-between gap-2 rounded-sm px-2 py-1.5 transition-colors",
                {
                  "text-accent bg-accent/10 font-semibold":
                    current === category,
                },
              ]}
            >
              <span class="truncate" title={categoryName}>
                {categoryName}
              </span>
              <span class="text-muted-foreground shrink-0 text-[0.8125rem] tabular-nums">
                {count}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>
